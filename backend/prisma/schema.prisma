generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model StatusCode {
  code        Int      @id
  description String
  imageUrl    String   @map("image_url")
  hits        Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("status_codes")
}
